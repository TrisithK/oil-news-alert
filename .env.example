# ---------------------------------------------------------------------------
# Oil News Alert — environment configuration
# Copy to .env and fill in. NEVER commit a real .env (see .gitignore).
# ---------------------------------------------------------------------------

# --- LLM (Anthropic) -------------------------------------------------------
# Get one at https://console.anthropic.com -> API Keys (starts with sk-ant-). Without it the
# system uses an offline heuristic classifier. After setting it, run `make up && make llm-check`.
ANTHROPIC_API_KEY=
# Pin exact dated version strings. Re-confirm against the Anthropic docs.
TRIAGE_MODEL=claude-haiku-4-5-20251001     # cheap relevance triage
EXTRACT_MODEL=claude-sonnet-4-6            # structured signal extraction
OPUS_MODEL=claude-opus-4-8                 # optional, hardest cases only

# --- Database --------------------------------------------------------------
# Inside Docker the api/worker containers override host with `db` (see
# docker-compose.yml). This localhost URL is for running tools on the host.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/oilalert

# --- External data feeds (free tiers) --------------------------------------
EIA_API_KEY=                  # https://www.eia.gov/opendata/ (free key)
NEWSDATA_API_KEY=             # optional
# GDELT 2.0 DOC API needs no key.

# --- Alert delivery --------------------------------------------------------
# Telegram (best demo): create a bot via @BotFather on Telegram (/newbot) -> it gives the token.
# For the chat id: message your bot once, then `make telegram-test` (or open
# https://api.telegram.org/bot<TOKEN>/getUpdates). After setting both, `make up`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=

# --- API -------------------------------------------------------------------
API_BEARER_TOKEN=devtoken

# --- Worker / scheduler ----------------------------------------------------
INGEST_INTERVAL_SEC=600
MAX_ITEMS_PER_CYCLE=50
ALERT_COOLDOWN_SEC=1800                   # event-level dedup window (anti alert-fatigue)

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
